# Copy to .streamlit/secrets.toml for local dev (gitignored), or paste into
# the Streamlit Community Cloud app's "Secrets" settings for deployment.
# Never commit a real secrets.toml.

ANTHROPIC_API_KEY = "sk-ant-..."

SNOWFLAKE_ACCOUNT = "xy12345.us-east-1"
SNOWFLAKE_USER = "CENSUS_APP_USER"
SNOWFLAKE_ROLE = "CENSUS_APP_ROLE"
SNOWFLAKE_WAREHOUSE = "CENSUS_APP_WH"
SNOWFLAKE_DATABASE = "<CENSUS_DB>"
SNOWFLAKE_SCHEMA = "<SCHEMA>"

# Key-pair auth (preferred - required if the account enforces MFA on password
# logins, which new Snowflake trial accounts do by default). Paste the full
# PEM private key, BEGIN/END lines included, as a TOML triple-quoted string.
# See snowflake/setup.sql for how to generate this and attach the public half
# to CENSUS_APP_USER.
SNOWFLAKE_PRIVATE_KEY = """
-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"""

# Only needed as a fallback if you deliberately use password auth instead
# (will fail on accounts with mandatory MFA - see README).
# SNOWFLAKE_PASSWORD = "..."
